{
  "name": "green-harvest-buddy-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace shortcuts for AI Crop Recommendation System",
  "scripts": {
    "install:web": "npm install --prefix web",
    "install:mobile": "npm install --prefix mobile",
    "install:all": "npm install --prefix web && npm install --prefix mobile",
    "dev": "npm run dev --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "mobile:start": "npm start --prefix mobile",
    "mobile:android": "npx react-native run-android --prefix mobile",
    "mobile:ios": "npx react-native run-ios --prefix mobile"
  }
}
